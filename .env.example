# Konto LIBRUS (e-mail), do którego powiązano konta wszystkich dzieci.
LIBRUS_PORTAL_EMAIL=rodzic@example.com
LIBRUS_PORTAL_PASSWORD=zmien_mnie

# Opcjonalne limity bezpieczeństwa.
LIBRUS_TIMEOUT_MS=30000
LIBRUS_MAX_RESULTS=100
LIBRUS_MAX_ATTACHMENT_BYTES=10485760
LIBRUS_ATTACHMENT_DIR=./attachments

# Tylko dla wersji zdalnej (npm run start:http).
MCP_ACCESS_TOKEN=wygeneruj_dlugie_losowe_haslo
PORT=3000
MCP_RATE_LIMIT_PER_MINUTE=30
